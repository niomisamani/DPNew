<!-- CONFETTI CANVAS -->
<canvas id="confetti-canvas"></canvas>

<!-- MUSIC CONTROL -->
<div class="music-control" id="musicControl">
  <button id="playPauseBtn" aria-label="Play/Pause">⏸️</button>
  <button id="muteBtn" aria-label="Mute/Unmute">🔊</button>
</div>

<script>
(function(){
  // --- DOM refs ---
  const envelope = document.getElementById('envelope');
  const btnOpen = document.getElementById('btnOpen');
  const sceneEnvelope = document.getElementById('scene-envelope');
  const sceneLily = document.getElementById('scene-lily');
  const sceneBalloons = document.getElementById('scene-balloons');
  const sceneCake = document.getElementById('scene-cake');
  const sceneLetter = document.getElementById('scene-letter');
  const balloonContainer = document.getElementById('balloon-container');
  const balloonProgress = document.getElementById('balloonProgress');
  const canvas = document.getElementById('confetti-canvas');
  const ctx = canvas.getContext('2d');
  const celebrationPopup = document.getElementById('celebration-popup');
  const btnReadLetter = document.getElementById('btnReadLetter');
  const btnBlow = document.getElementById('btnBlow');
  const blowMessage = document.getElementById('blowMessage');
  const btnLilyNext = document.getElementById('btnLilyNext');

  let W, H;
  const resizeCanvas = () => { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; };
  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();

  // Audio context for blow detection
  let audioCtx = null, analyser = null, micStream = null, isListening = false, blowDetected = false;

  // Background Music
  let bgMusic = new Audio('assets/audio.mp3');
  bgMusic.loop = true;
  bgMusic.volume = 0.4;
  let musicPlaying = false;
  let musicMuted = false;

  // Confetti state
  let confettiPieces = [], confettiRunning = false;

  // State
  let envelopeOpened = false;
  let balloonsPopped = 0;
  const totalBalloons = 7;
  let candlesBlown = false;
  let celebrationShown = false;

  // --- ENVELOPE OPEN ---
  function openEnvelope() {
    if (envelopeOpened) return;
    envelopeOpened = true;
    envelope.classList.add('open');
    spawnSparkles(15);
    spawnConfetti(80, {x: window.innerWidth/2, y: window.innerHeight/2});
    setTimeout(() => {
      sceneEnvelope.classList.add('hidden');
      sceneLily.classList.remove('hidden');
      // Start background music
      bgMusic.play().catch(() => {});
      musicPlaying = true;
      document.getElementById('playPauseBtn').textContent = '⏸️';
    }, 700);
  }
  btnOpen.addEventListener('click', openEnvelope);
  document.querySelector('.envelope-wrapper').addEventListener('click', openEnvelope);

  // --- LILY TO BALLOONS ---
  btnLilyNext.addEventListener('click', function() {
    sceneLily.classList.add('hidden');
    sceneBalloons.classList.remove('hidden');
    initBalloons();
  });

  // --- BALLOONS ---
  const balloonMessages = [
    'Pookie Bestie 💛', 'Bhondu Chuha 🐭', 'Lambu Giraffe 🦒',
    'Chat Treat Pending', 'BEHAVE.', 'Bhabhi Deadline 🚨', 'No Refunds.'
  ];
  const balloonColors = ['#FFB6C1', '#DDA0DD', '#FFD700', '#87CEEB', '#FFA07A', '#98FB98', '#FF69B4'];

  function initBalloons() {
    balloonContainer.innerHTML = '';
    balloonsPopped = 0;
    updateProgress();
    const positions = [];
    for (let i = 0; i < totalBalloons; i++) {
      positions.push({
        left: 5 + Math.random() * 85,
        top: 5 + Math.random() * 75
      });
    }
    for (let i = 0; i < totalBalloons; i++) {
      const el = document.createElement('div');
      el.className = 'balloon';
      el.style.background = balloonColors[i % balloonColors.length];
      el.style.left = positions[i].left + '%';
      el.style.top = positions[i].top + '%';
      el.textContent = balloonMessages[i % balloonMessages.length];
      el.dataset.index = i;
      el.addEventListener('click', function(e) {
        e.stopPropagation();
        if (!this.classList.contains('popped')) {
          popBalloon(this);
        }
      });
      balloonContainer.appendChild(el);
      gentleFloat(el);
    }
  }

  function gentleFloat(el) {
    let dy = -0.2 - Math.random() * 0.3;
    let phase = Math.random() * 100;
    function float() {
      if (!el.parentNode || el.classList.contains('popped')) return;
      let top = parseFloat(el.style.top) + dy;
      if (top < 2 || top > 85) dy *= -1;
      el.style.top = top + '%';
      el.style.transform = `translateX(${Math.sin(performance.now()/3000 + phase)*3}px)`;
      requestAnimationFrame(float);
    }
    setTimeout(float, 100);
  }

  function popBalloon(el) {
    if (el.classList.contains('popped')) return;
    el.classList.add('popped', 'pop-anim');
    balloonsPopped++;
    updateProgress();
    const rect = el.getBoundingClientRect();
    spawnConfetti(30, {x: rect.left + rect.width/2, y: rect.top + rect.height/2});
    spawnSparkles(6);
    setTimeout(() => {
      el.style.display = 'none';
      if (balloonsPopped === totalBalloons) {
        setTimeout(() => {
          sceneBalloons.classList.add('hidden');
          sceneCake.classList.remove('hidden');
          blowMessage.textContent = '🎤 Now blow the candles!';
        }, 400);
      }
    }, 400);
  }

  function updateProgress() {
    balloonProgress.textContent = `${balloonsPopped} / ${totalBalloons} popped`;
  }

  // --- CANDLES (Blow button handles everything) ---
  async function startMic() {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      micStream = stream;
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 256;
        const source = audioCtx.createMediaStreamSource(stream);
        source.connect(analyser);
      }
      isListening = true;
      listenBlow();
    } catch(e) {
      blowMessage.textContent = '⚠️ Mic not available. Click again to blow!';
    }
  }

  function listenBlow() {
    if (!isListening || !analyser) return;
    const data = new Uint8Array(analyser.fftSize);
    analyser.getByteFrequencyData(data);
    let sum = 0;
    for (let v of data) sum += v;
    const avg = sum / data.length;
    if (avg > 70 && !blowDetected) {
      blowDetected = true;
      extinguishCandles();
    }
    requestAnimationFrame(listenBlow);
  }

  function stopMic() {
    if (micStream) micStream.getTracks().forEach(t => t.stop());
    isListening = false;
  }

  function extinguishCandles() {
    if (candlesBlown) return;
    candlesBlown = true;
    document.querySelectorAll('.candle').forEach(c => c.classList.add('extinct'));
    blowMessage.textContent = '💨 Whoosh! Candles out! ✨';
    spawnConfetti(150, {x: window.innerWidth/2, y: window.innerHeight/2 - 80});
    spawnSparkles(25);
    setTimeout(() => {
      showCelebration();
    }, 500);
  }

  let blowAttempts = 0;
  btnBlow.addEventListener('click', function() {
    if (candlesBlown) return;
    blowAttempts++;
    if (blowAttempts === 1) {
      startMic();
      blowMessage.textContent = '🎤 Blow into the mic... or click again to blow manually!';
      setTimeout(() => {
        if (!candlesBlown) {
          blowMessage.textContent = '⏳ Click "BLOW THE CANDLES" again to blow manually.';
        }
      }, 4000);
    } else {
      if (!candlesBlown) {
        stopMic();
        extinguishCandles();
      }
    }
  });

  // --- CELEBRATION POPUP ---
  function showCelebration() {
    if (celebrationShown) return;
    celebrationShown = true;
    celebrationPopup.classList.add('show');
    spawnConfetti(200, {x: window.innerWidth/2, y: window.innerHeight/2});
    spawnSparkles(30);
  }

  btnReadLetter.addEventListener('click', function() {
    celebrationPopup.classList.remove('show');
    sceneCake.classList.add('hidden');
    sceneLetter.classList.remove('hidden');
    document.querySelector('.letter-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
    spawnConfetti(60, {x: window.innerWidth/2, y: window.innerHeight/2});
  });

  // --- SPARKLES ---
  function spawnSparkles(count) {
    const emojis = ['✨', '⭐', '🌟', '💖', '🌷', '🌸', '🎉'];
    for (let i = 0; i < count; i++) {
      const el = document.createElement('div');
      el.className = 'sparkle';
      el.textContent = emojis[Math.floor(Math.random() * emojis.length)];
      el.style.left = (10 + Math.random() * 80) + '%';
      el.style.top = (10 + Math.random() * 80) + '%';
      el.style.fontSize = (18 + Math.random() * 28) + 'px';
      el.style.animationDuration = (0.8 + Math.random() * 0.6) + 's';
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 1500);
    }
  }

  // --- CONFETTI ---
  function spawnConfetti(count, pos) {
    const x = pos.x || window.innerWidth/2;
    const y = pos.y || window.innerHeight/2;
    for (let i = 0; i < count; i++) {
      const angle = Math.random() * 2 * Math.PI;
      const speed = 2 + Math.random() * 5;
      confettiPieces.push({
        x, y,
        vx: Math.cos(angle) * speed * (0.5 + Math.random()),
        vy: Math.sin(angle) * speed * (0.5 + Math.random()) - 3,
        w: 5 + Math.random() * 8,
        h: 3 + Math.random() * 5,
        color: `hsl(${Math.random() * 360}, 80%, 65%)`,
        life: 1.0,
        decay: 0.006 + Math.random() * 0.01,
        rot: Math.random() * 360
      });
    }
    if (!confettiRunning) { confettiRunning = true; animateConfetti(); }
  }

  function animateConfetti() {
    ctx.clearRect(0, 0, W, H);
    let alive = false;
    for (let p of confettiPieces) {
      p.x += p.vx;
      p.y += p.vy;
      p.vy += 0.05;
      p.life -= p.decay;
      if (p.life <= 0) continue;
      alive = true;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot * Math.PI / 180);
      ctx.globalAlpha = p.life;
      ctx.fillStyle = p.color;
      ctx.fillRect(-p.w/2, -p.h/2, p.w, p.h);
      ctx.restore();
    }
    confettiPieces = confettiPieces.filter(p => p.life > 0);
    if (alive || confettiPieces.length) {
      requestAnimationFrame(animateConfetti);
    } else {
      confettiRunning = false;
      ctx.clearRect(0, 0, W, H);
    }
  }

  // --- MUSIC CONTROLS ---
  document.getElementById('playPauseBtn').addEventListener('click', function() {
    if (musicPlaying) {
      bgMusic.pause();
      musicPlaying = false;
      this.textContent = '▶️';
    } else {
      bgMusic.play().catch(() => {});
      musicPlaying = true;
      this.textContent = '⏸️';
    }
  });
  document.getElementById('muteBtn').addEventListener('click', function() {
    musicMuted = !musicMuted;
    bgMusic.muted = musicMuted;
    this.textContent = musicMuted ? '🔇' : '🔊';
  });

  // --- REDUCED MOTION ---
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.balloon').forEach(b => b.style.animation = 'none');
  }

  console.log('🎂 Happy Birthday Darshan!');
})();
</script>
